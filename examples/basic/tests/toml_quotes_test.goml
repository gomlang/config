package tests;

use ecosystem::config;
use std::testing;

#[test]
fn downstream_unsupported_multiline_toml_returns_a_parse_error() -> () {
    for input in["message = \"\"\"hello\"\"\"", "message = '''hello'''"] {
        let error = testing::expect_err(
            config::Builder::new().with_source(config::Source::toml("app.toml", input)).build(),
            "unsupported multiline TOML",
        );
        testing::assert_eq(error.kind, config::ErrorKind::Parse);
        testing::assert_eq(error.origin.source, "app.toml");
    }
}

#[test]
fn downstream_toml_does_not_concatenate_adjacent_quoted_values() -> () {
    let error = testing::expect_err(
        config::Builder::new().with_source(
            config::Source::toml("app.toml", "message = \"first\" \"second\""),
        ).build(),
        "adjacent TOML strings",
    );
    testing::assert_eq(error.kind, config::ErrorKind::Parse);
}

#[test]
fn downstream_toml_key_punctuation_does_not_join_string_values() -> () {
    for input in[
        "message = \"first\".\"second\"",
        "message = { key = 'first'='second' }",
        "message = \"first\",\"second\"",
        "message = 'first']'second'",
        "[\"first\",\"second\"]\nvalue = 1",
    ] {
        let error = testing::expect_err(
            config::Builder::new().with_source(config::Source::toml("app.toml", input)).build(),
            "key punctuation after a value",
        );
        testing::assert_eq(error.kind, config::ErrorKind::Parse);
        testing::assert_eq(error.origin.source, "app.toml");
    }
}

#[test]
fn downstream_toml_rejects_raw_controls_and_bare_carriage_returns() -> () {
    for input in["value='a\u0000b'", "value=1 # hidden\u007f", "value=1\r"] {
        let error = testing::expect_err(
            config::Builder::new().with_source(config::Source::toml("app.toml", input)).build(),
            "invalid raw TOML control",
        );
        testing::assert_eq(error.kind, config::ErrorKind::Parse);
        testing::assert_eq(error.origin.source, "app.toml");
    }
}

#[test]
fn downstream_toml_table_headers_reject_quoted_assignments() -> () {
    let error = testing::expect_err(
        config::Builder::new().with_source(
            config::Source::toml("app.toml", "[\"x\"=\"y\"]\nvalue=1"),
        ).build(),
        "table header assignment",
    );
    testing::assert_eq(error.kind, config::ErrorKind::Parse);
}

#[test]
fn downstream_toml_dotted_keys_cannot_end_after_a_separator() -> () {
    let error = testing::expect_err(
        config::Builder::new().with_source(
            config::Source::toml("app.toml", "[\"parent\".]\nvalue=1"),
        ).build(),
        "missing table-key component",
    );
    testing::assert_eq(error.kind, config::ErrorKind::Parse);
}
