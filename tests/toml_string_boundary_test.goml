package tests;

use ecosystem::config;
use std::testing;

#[test]
fn toml_quoted_values_and_keys_reject_concatenated_tokens() -> () {
    for input in[
        "value = \"first\" \"second\"",
        "value = 'first' 'second'",
        "value = \"first\"junk\"second\"",
        "value = \"first\"\"second\"",
        "value = ['first' 'second']",
        "value = { item = \"first\" \"second\" }",
        "\"first\" \"second\" = 1",
        "['first' 'second']\nvalue = 1",
        "value = \"first\".\"second\"",
        "value = 'first'='second'",
        "value = [\"first\".\"second\"]",
        "value = ['first'='second']",
        "value = { item = \"first\".\"second\" }",
        "value = { item = 'first'='second' }",
        "value = \"first\",\"second\"",
        "value = 'first']'second'",
        "value = \"first\"}\"second\"",
        "\"first\",\"second\" = 1",
        "[\"first\",\"second\"]\nvalue = 1",
    ] {
        let error = testing::expect_err(
            config::Builder::new().with_source(config::Source::toml("invalid.toml", input)).build(),
            "invalid TOML string boundary",
        );
        testing::assert_eq(error.kind, config::ErrorKind::Parse);
        testing::assert_eq(error.origin.source, "invalid.toml");
    }
}

#[test]
fn toml_quoted_key_positions_resume_after_nested_containers_and_comments() -> () {
    let input = "object = { 'outer' = { \"inner\" = 'one' }, 'array' = ['two', { 'key' = \"three\" }], \"other\" = 'four' }\n\"first\" . 'second' = \"five\" # comment \" = .\n\"last\" = 'six'\n";
    let snapshot = testing::expect_ok(
        config::Builder::new().with_source(config::Source::toml("keys.toml", input)).build(),
        "nested quoted key positions",
    );
    for (path, expected) in[
        ("/object/outer/inner", "one"),
        ("/object/array/0", "two"),
        ("/object/array/1/key", "three"),
        ("/object/other", "four"),
        ("/first/second", "five"),
        ("/last", "six"),
    ] {
        let actual: string = testing::expect_ok(snapshot.decode_at(path), "string");
        testing::assert_eq(actual, expected);
    }
}

#[test]
fn toml_table_headers_do_not_accept_assignment_separators_between_quoted_names() -> () {
    for input in[
        "[\"x\"=\"y\"]\nx=1",
        "['x'='y']\nx=1",
        "[\"\"=\"y\"]\nx=1",
        "[\"q\\\"x\"=\"y\"]\nx=1",
        "[\"x\" = \"y\"]\nx=1",
        "[\"x\".'y'='z']\nx=1",
    ] {
        let error = testing::expect_err(
            config::Builder::new().with_source(config::Source::toml("header.toml", input)).build(),
            "table header assignment separator",
        );
        testing::assert_eq(error.kind, config::ErrorKind::Parse);
        testing::assert_eq(error.origin.source, "header.toml");
    }
    let snapshot = testing::expect_ok(
        config::Builder::new().with_source(
            config::Source::toml(
                "keys.toml",
                "\"top=key\"=1\nobject={'inline=key'=2}\n[\"table=name\".'nested=key']\n\"value=key\"=3\n",
            ),
        ).build(),
        "equals signs inside quoted keys",
    );
    for (path, expected) in[
        ("/top=key", 1),
        ("/object/inline=key", 2),
        ("/table=name/nested=key/value=key", 3),
    ] {
        let value: isize = testing::expect_ok(snapshot.decode_at(path), "quoted key value");
        testing::assert_eq(value, expected);
    }
}

#[test]
fn toml_dotted_keys_require_a_component_after_the_final_dot() -> () {
    for input in[
        "name.=1",
        "\"name\".=1",
        "\"name\". \t=1",
        "[name.]\nvalue=1",
        "[\"name\". \t]\nvalue=1",
        "[parent.\"name\".]\nvalue=1",
        "object={name.=1}",
    ] {
        let error = testing::expect_err(
            config::Builder::new().with_source(config::Source::toml("dotted.toml", input)).build(),
            "missing final dotted-key component",
        );
        testing::assert_eq(error.kind, config::ErrorKind::Parse);
        testing::assert_eq(error.origin.source, "dotted.toml");
    }
}

#[test]
fn toml_quoted_empty_components_literal_dots_and_numeric_values_remain_distinct() -> () {
    let snapshot = testing::expect_ok(
        config::Builder::new().with_source(
            config::Source::toml(
                "valid.toml",
                "\"name.\"=1\nroot.\"\"=2\nobject={'name.'=3}\nnumber=1.25\nitems=[4,5,]\n[\"table\".'']\nvalue=6\n",
            ),
        ).build(),
        "complete dotted keys and values",
    );
    for (path, expected) in[
        ("/name.", 1),
        ("/root/", 2),
        ("/object/name.", 3),
        ("/items/1", 5),
        ("/table//value", 6),
    ] {
        let value: isize = testing::expect_ok(snapshot.decode_at(path), "complete key");
        testing::assert_eq(value, expected);
    }
    let number: f64 = testing::expect_ok(snapshot.decode_at("/number"), "floating value");
    testing::assert_eq(number, 1.25);
}

#[test]
fn toml_string_boundaries_allow_quoted_keys_containers_and_comments() -> () {
    let input = "\"parent\" . 'child' = \"one\" # \"ignored\"\nitems = [\"two\", 'three']\nobject = { \"key\" = 'four', 'other' = \"five\" }\n[\"section\" . 'nested']\nvalue = \"six\"\t# 'ignored'\n";
    let snapshot = testing::expect_ok(
        config::Builder::new().with_source(config::Source::toml("valid.toml", input)).build(),
        "supported TOML delimiters",
    );
    for (path, expected) in[
        ("/parent/child", "one"),
        ("/items/0", "two"),
        ("/items/1", "three"),
        ("/object/key", "four"),
        ("/object/other", "five"),
        ("/section/nested/value", "six"),
    ] {
        let value: string = testing::expect_ok(snapshot.decode_at(path), "string");
        testing::assert_eq(value, expected);
    }
}
